{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mc-plan.example/events/resource.published.v1.json",
  "title": "resource.published.v1",
  "allOf": [
    { "$ref": "../schemas/common/event-envelope.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "resource.published.v1" },
        "data": {
          "type": "object",
          "required": ["resource_id", "version_id", "owner_user_id", "resource_type"],
          "properties": {
            "resource_id": { "type": "string", "minLength": 1 },
            "version_id": { "type": "string", "minLength": 1 },
            "owner_user_id": { "type": "string", "minLength": 1 },
            "resource_type": { "type": "string", "enum": ["skin"] }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
