{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mc-plan.example/core/admin-credit-ledger-page.v1.json",
  "title": "AdminCreditLedgerPage",
  "type": "object",
  "required": ["items", "next_cursor"],
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "admin-credit-ledger-entry.json" }
    },
    "next_cursor": {
      "type": ["string", "null"],
      "description": "Opaque cursor after the last returned entry. Null when no older entries remain."
    }
  },
  "additionalProperties": false
}
