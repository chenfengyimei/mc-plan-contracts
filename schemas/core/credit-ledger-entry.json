{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mc-plan.example/core/credit-ledger-entry.v1.json",
  "title": "CreditLedgerEntry",
  "type": "object",
  "required": ["entry_id", "user_id", "kind", "amount", "balance_before", "balance_after", "source", "created_at"],
  "properties": {
    "entry_id": { "type": "string", "minLength": 1 },
    "user_id": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["grant", "consume", "refund", "adjustment"] },
    "amount": { "type": "integer" },
    "balance_before": { "type": "integer", "minimum": 0 },
    "balance_after": { "type": "integer", "minimum": 0 },
    "source": { "type": "string", "minLength": 1 },
    "reference_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
